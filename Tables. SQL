create table team
(
    teamid     integer not null
        constraint teamid
            primary key,
    teamname   varchar,
    city       varchar,
    conference varchar,
    division   varchar,
    arena      varchar
);

alter table team
    owner to postgres;

create table players
(
    playerid   integer not null
        constraint playerid
            primary key,
    playername varchar,
    teamid     integer
        constraint "Teams.TeamID"
            references team,
    height     varchar,
    weight     integer,
    position   varchar
);

alter table players
    owner to postgres;

create table season
(
    seasonid   integer not null
        constraint seasonid
            primary key,
    seasonyear varchar,
    startdate  date,
    enddate    date
);

alter table season
    owner to postgres;

create table games
(
    gameid       integer not null
        constraint gameid
            primary key,
    matchdate    date,
    opposingteam varchar,
    result       varchar,
    seasonid     integer
        constraint seasonid_games
            references season
);

alter table games
    owner to postgres;

create table playerstats
(
    playerid   integer
        constraint "Players.PlayerID"
            references players,
    gameid     integer
        constraint "Games.GamesID"
            references games,
    stattypeid integer,
    statvalue  integer
);

alter table playerstats
    owner to postgres;

create table statstype
(
    stattypeid integer,
    statname   varchar
);

alter table statstype
    owner to postgres;



